# Copy to .env.local and fill in values for local development.
# In production (Firebase App Hosting), public values are in apphosting.yaml
# and secrets live in Google Secret Manager.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (public token — restrict by URL in Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Booking.com Demand API
BOOKING_API_BASE_URL=https://demandapi.booking.com/3.1
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=

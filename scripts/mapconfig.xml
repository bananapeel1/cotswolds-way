<?xml version="1.0" encoding="UTF-8"?>
<!--
  osm2pgrouting mapconfig for the Cotswolds AONB walking-route extract.

  Highway classes we accept, with cost multipliers ('priority') tuned for
  walkers — lower priority = lower cost = more attractive route. The route
  engine reads cost_off_road from the resulting `ways` table.

  - Footpaths/bridleways/tracks: priority 1.0  (free movement)
  - Service/residential roads:   priority 3.0  (acceptable for connectors)
  - Tertiary roads:              priority 6.0  (avoid where possible)
  - Primary/secondary roads:     priority 12.0 (only as last resort)

  References:
    https://github.com/pgRouting/osm2pgrouting/blob/main/mapconfig_for_cars.xml
-->
<configuration>
  <tag_name name="highway" id="100">
    <tag_value name="footway"     id="101" priority="1.0"  maxspeed="5"  />
    <tag_value name="path"        id="102" priority="1.0"  maxspeed="5"  />
    <tag_value name="bridleway"   id="103" priority="1.0"  maxspeed="5"  />
    <tag_value name="track"       id="104" priority="1.2"  maxspeed="5"  />
    <tag_value name="cycleway"    id="105" priority="1.5"  maxspeed="5"  />
    <tag_value name="pedestrian"  id="106" priority="1.0"  maxspeed="5"  />
    <tag_value name="steps"       id="107" priority="1.3"  maxspeed="3"  />
    <tag_value name="service"     id="110" priority="3.0"  maxspeed="20" />
    <tag_value name="residential" id="111" priority="3.0"  maxspeed="30" />
    <tag_value name="unclassified" id="112" priority="4.0" maxspeed="40" />
    <tag_value name="tertiary"    id="113" priority="6.0"  maxspeed="40" />
    <tag_value name="secondary"   id="114" priority="12.0" maxspeed="50" />
    <tag_value name="primary"     id="115" priority="12.0" maxspeed="60" />
  </tag_name>
</configuration>
